{
  "backend": "nb",
  "model": "../models/network_binary_v4.nb",
  "library": "../libpadim_camera.so",
  "onnx_model": "../models/resnet18_features.onnx",
  "metadata": "../models/nbg_meta.json",
  "statistics": "../models/padim_statistics.npz",
  "map_width": 64,
  "map_height": 64,
  "camera": "/dev/video0",
  "width": 1280,
  "height": 720,
  "camera_fps": 60,
  "camera_buffers": 4,
  "stream_fps": 10,
  "jpeg_quality": 80,
  "stale_seconds": 5.0,
  "threshold": 25.0,
  "threshold_calibrated": false,
  "persistence_frames": 3,
  "heatmap_min": 0.0,
  "heatmap_max": 35.0,
  "heatmap_alpha": 0.5,
  "events_dir": "../events",
  "record_events": true,
  "host": "0.0.0.0",
  "port": 5000,
  "preprocessing": "pil",
  "scoring": "npu",
  "score_model": "../models/network_binary_score.nb",
  "score_metadata": "../models/score_meta.json",
  "heatmap_visible_fraction": 0.6,
  "crop_position": {
    "x": 0.5,
    "y": 0.5
  }
}
